AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE_NAME=your_dynamodb_table_name

# Optional: alias for DYNAMODB_TABLE_NAME. Configure only one table-name variable.
# DYNAMODB_TABLE=your_dynamodb_table_name

# Optional: GSI used by listPlayers. Without it, the app falls back to DynamoDB Scan.
# DYNAMODB_LIST_INDEX_NAME=your_list_index_name
